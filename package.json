{
  "name": "coffee-s-crafts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node site/build.js",
    "check:syntax": "node --check site/build.js && node --check site/previews.js && node --check site/promotions.js && node --check site/static/gallery.js && node --check site/static/brief.js",
    "test": "node --test tests/*.test.cjs",
    "check:output": "node scripts/check-output.cjs",
    "check:browser": "playwright test",
    "serve": "npm run build && node scripts/serve.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "html-validate": "11.16.2"
  },
  "engines": {
    "node": ">=24"
  }
}
